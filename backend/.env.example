# INKSHIELD backend environment variables (placeholders only — no secrets).
# The app reads configuration from the process environment only: export
# these in your shell or set them in your deployment dashboard (e.g. the
# Render Environment tab). A .env file is NOT auto-loaded, and real
# values must never be committed.

# Application name reported by the API.
INKSHIELD_APP_NAME=INKSHIELD API

# API version exposed by GET /api/v1/health.
INKSHIELD_API_VERSION=v1

# Deployment environment label (development, staging, production).
INKSHIELD_ENVIRONMENT=development

# Comma-separated list of browser origins allowed by CORS (the Next.js
# frontend). Defaults to local dev origins; in production set this to the
# deployed frontend origin, e.g. https://your-app.vercel.app
INKSHIELD_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
