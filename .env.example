# Frontend environment variables (local defaults — no secrets).
# Copy to .env.local to override; never commit real values.

# Base URL of the INKSHIELD FastAPI backend, without a trailing slash.
# Local development default (used when unset): http://127.0.0.1:8000
# Production (e.g. Vercel): this MUST be set to the deployed API origin,
# e.g. https://your-api.onrender.com — the frontend will not assume localhost.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
